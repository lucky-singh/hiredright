# ---------------------------------------------------------------------------
# HireRight environment — copy to `.env` and adjust for your environment.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=hiredright
POSTGRES_USER=hiredright
POSTGRES_PASSWORD=hiredright
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache + Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# CORS (comma-separated origins for prod; dev allows all)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MinIO / S3-compatible object storage (optional in dev)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1

# Email (SMTP for prod; console backend in dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SMS backend for mobile OTP. Dev defaults to the console backend; production
# has no fallback and requires this to be set to a real provider.
SMS_BACKEND=accounts.sms.ConsoleSMSBackend

# LinkedIn OIDC (social login)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=